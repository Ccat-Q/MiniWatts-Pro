        }
      }
    },
    "Comparison values cover the selected charge interval. Recorded peaks and temperature use saved samples." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比较指标仅统计所选电量区间。记录峰值与温度使用已保存的采样点。"
          }
        }
      }
    },
    "Selected history changed. Retry export." : {
