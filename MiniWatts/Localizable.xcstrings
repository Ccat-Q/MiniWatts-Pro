            "value" : "分页轮播"
          }
        }
      }
    },
    "Select at least one item to display." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少选择一项显示内容。"
          }
        }
      }
    },
    "Choose all temperatures or one component; the iOS system thermal state is always shown. Together shows power and temperatures at the same time; Separate pages alternates between them every four seconds." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温度可选择全部部件或单独一个部件，且始终显示 iOS 系统发热状态。同屏模式同时显示功率和温度；分页轮播模式每四秒切换一次。"
          }
        }
      }
    },
    "Primary readout" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主要读数"
          }
        }
      }
    },
    "The compact Dynamic Island shows this reading. Press and hold it to see power, SoC, battery and hottest-component temperatures together." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灵动岛紧凑状态显示此项读数。长按展开后可同时查看功率、SoC、电池和最高部件温度。"
          }
        }
      }
    },
    "End Live Activity" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结束实时活动"
          }
        }
      }
    },
    "Load + loss" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "负载与损耗"
          }
        }
      }
    },
    "cell watts ÷ measured input watts" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电芯功率 ÷ 实测输入功率"
          }
