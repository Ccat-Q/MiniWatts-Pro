    "hold status unknown" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持状态未知"
          }
        }
      }
    },
    "No elevated system thermal pressure." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统没有升高的热压力。"
          }
        }
      }
    },
    "Warming up. iOS may trim performance or charge current." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备正在升温，iOS 可能降低性能或充电电流。"
          }
        }
      }
    },
    "High system thermal pressure. iOS may limit charge current and clocks." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统热压力较高，iOS 可能限制充电电流和处理器频率。"
          }
        }
      }
    },
    "Critical thermal pressure. iOS may suspend charging until the phone cools." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统热压力达到临界值，iOS 可能暂停充电，直到设备冷却。"
          }
        }
      }
    },
    "Unrecognised system thermal state." : {
      "localizations" : {
